# Copy to .env and fill in what you need. Every value is optional.

# Reasoning. `claude` needs credentials; `template` is the deterministic fallback.
# ANTHROPIC_API_KEY=sk-ant-...
# OPS_RECALL_REASONER=claude
# OPS_RECALL_MODEL=claude-opus-5
# OPS_RECALL_AGENTIC_CHECKS=true

# Embeddings. `hashing` runs offline; `voyage` is what you want in production.
# OPS_RECALL_EMBEDDER=voyage
# OPS_RECALL_VOYAGE_API_KEY=pa-...

# Storage. Unset means an embedded in-memory Qdrant rebuilt at startup.
# OPS_RECALL_QDRANT_URL=http://localhost:6333
# OPS_RECALL_QDRANT_API_KEY=
# OPS_RECALL_QDRANT_PATH=./.qdrant

# Retrieval and time decay.
# OPS_RECALL_HALF_LIFE_DAYS=365
# OPS_RECALL_RECENCY_FLOOR=0.6
# OPS_RECALL_MIN_SIMILARITY=0.30
# OPS_RECALL_TOP_K=3

# Live ingest (used by `ops-recall ingest --live`).
# OPS_RECALL_SLACK_BOT_TOKEN=xoxb-...
# OPS_RECALL_SLACK_CHANNELS=["C02OPSWAR"]
# OPS_RECALL_PAGERDUTY_API_KEY=
